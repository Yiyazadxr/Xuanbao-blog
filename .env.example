# 复制本文件为 .env 并填入真实值

# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== Auth.js 认证密钥（openssl rand -base64 32 生成）=====
AUTH_SECRET=""
# 生产环境信任 Host 头（自托管在非标准 Host 时设为 true；默认关闭更安全）
AUTH_TRUST_HOST="false"

# ===== 站点地址（生产必填，用于 sitemap/RSS/元数据）=====
NEXT_PUBLIC_SITE_URL="https://xuanbao.dev"

# ===== 博主管理员账号（种子脚本创建）=====
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ===== 邮件通知（QQ 邮箱 SMTP，未配置时降级为控制台打印）=====
# SMTP_PASS 是 QQ 邮箱设置里生成的"授权码"，不是 QQ 密码
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
