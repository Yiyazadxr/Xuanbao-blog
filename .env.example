# 复制本文件为 .env 并填入真实值

# ===== 数据库 =====
DATABASE_URL="file:./dev.db"

# ===== Auth.js 认证密钥（openssl rand -base64 32 生成）=====
AUTH_SECRET=""

# ===== 博主管理员账号（种子脚本创建）=====
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# ===== 邮件通知（QQ 邮箱 SMTP，未配置时降级为控制台打印）=====
# SMTP_PASS 是 QQ 邮箱设置里生成的"授权码"，不是 QQ 密码
SMTP_HOST="smtp.qq.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
