// 暄宝xr 的博客 — 数据模型
// SQLite 不支持枚举，角色/状态字段用 String 存储约定值

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 用户：role 取值 SUPER_ADMIN | ADMIN | MEMBER（游客无账号记录）
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // bcrypt 哈希
  image     String?
  role      String   @default("MEMBER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts        Post[]
  comments     Comment[]
  likes        Like[]
  inviteCode   InviteCode?
  notifications Notification[]
}

// 文章分类（一篇文章属于一个分类）
model Category {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  posts       Post[]
}

// 文章系列/专题（一篇多集内容归入同一系列，如「Next.js 教程」）
model Series {
  id          String  @id @default(cuid())
  name        String  @unique
  slug        String  @unique
  description String?
  createdAt   DateTime @default(now())
  posts       Post[]
}

// 标签（与文章多对多）
model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

// 文章：content 为 Markdown 文本
// 状态语义：published=false 为草稿(DRAFT)；published=true 且 archived=false 为已发布(PUBLISHED)；archived=true 为已归档(ARCHIVED)
model Post {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  content     String
  excerpt     String?
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime? // 首次发布时间
  archived    Boolean   @default(false)
  pinned      Boolean   @default(false) // 置顶（列表页排最前）
  featured    Boolean   @default(false)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId   String
  author     User      @relation(fields: [authorId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  seriesId   String?
  series     Series?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tags       PostTag[]
  comments   Comment[]
  likes      Like[]
  revisions  PostRevision[]

  @@index([published, createdAt])
}

// 文章-标签 中间表
model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// 评论：审核制（isApproved 默认 false），parentId 支持嵌套回复
model Comment {
  id         String   @id @default(cuid())
  content    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, isApproved])
}

// 点赞：一个用户对一篇文章只能赞一次
model Like {
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
}

// 账号申请：status 取值 PENDING | APPROVED | REJECTED
model AccountRequest {
  id        String   @id @default(cuid())
  email     String
  message   String?
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

// 邀请码：可绑定指定邮箱，使用后关联注册用户
model InviteCode {
  id        String    @id @default(cuid())
  code      String    @unique
  email     String? // 绑定邮箱（可选），绑定后仅该邮箱可用
  usedById  String?   @unique
  usedBy    User?     @relation(fields: [usedById], references: [id])
  createdAt DateTime  @default(now())
  expiresAt DateTime?
}

// 角色权限配置：role 为角色，permissions 存 JSON 数组（如 ["comment","like"]）
// 超级管理员固定全开不在此表；未配置的角色回落到代码默认值，新增权限零迁移成本
model RolePermission {
  role        String   @id
  permissions String // JSON 数组字符串
  updatedAt   DateTime @updatedAt
}

// 限流计数：key 为限流维度（如 login:email:ip），固定窗口计数，多实例共享（生产用 Postgres）
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// 站内通知：type 取值 comment | reply | account_request | comment_approved 等
// 接收者 userId 为该通知的所属用户（管理员收到审核类通知，普通用户收到审核结果通知）
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

// 文章版本快照：每次保存前记录旧状态，支持历史查看与回滚
// tags 存标签名 JSON 数组字符串（如 ["Next.js","前端"]）
model PostRevision {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  title      String
  slug       String
  content    String
  excerpt    String?
  coverImage String?
  categoryId String?
  seriesId   String?
  tags       String // JSON 数组
  published  Boolean
  pinned     Boolean
  featured   Boolean
  archived   Boolean
  authorId   String?
  createdAt  DateTime @default(now())

  @@index([postId, createdAt])
}
